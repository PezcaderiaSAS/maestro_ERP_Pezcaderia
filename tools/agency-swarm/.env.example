# =====================================================================
# Configuración de Agency Swarm con Google AI Studio (API Gratuita)
# =====================================================================
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
# El plan gratuito de Google AI Studio ofrece generosos límites diarios y RPM
# sin costo de suscripción.

GEMINI_API_KEY=tu_api_key_gratuita_aqui

# Modelo por defecto (Recomendado para máxima cuota RPM: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
