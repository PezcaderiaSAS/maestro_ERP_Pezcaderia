generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  ADMIN
  SUPERVISOR
  VENDEDOR
  CAJERO
  BODEGUERO
  CONDUCTOR
}

enum TipoIdentificacion {
  NIT
  CC
  CE
  PASAPORTE
}

enum TipoPersona {
  NATURAL
  JURIDICA
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  APROBADA
  VENDIDA
  CANCELADA
}

enum ClasificacionAbc {
  A
  B
  C
}

enum TipoMovimientoKardex {
  ENTRADA_COMPRA
  SALIDA_VENTA
  MERMA_DESPIECE
  AJUSTE_INVENTARIO
  TRASLADO
}

enum EstadoLote {
  ACTIVO
  CUARENTENA
  EXPIRADO
  AGOTADO
}

enum EstadoOutbox {
  PENDIENTE
  SINCRONIZADO
  ERROR
}

model Empresa {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nit             String         @unique @db.VarChar(20)
  razonSocial     String         @map("razon_social") @db.VarChar(255)
  nombreComercial String?        @map("nombre_comercial") @db.VarChar(255)
  direccion       String?        @db.VarChar(255)
  telefono        String?        @db.VarChar(50)
  email           String?        @db.VarChar(150)
  activo          Boolean        @default(true)
  creadoEn        DateTime       @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn   DateTime       @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  // Relaciones Multi-Tenant
  usuarios        Usuario[]
  terceros        Tercero[]
  productos       Producto[]
  bodegas         Bodega[]
  pedidos         Pedido[]
  cotizaciones    Cotizacion[]
  cajas           Caja[]
  empleados       Empleado[]
  lotes           Lote[]
  kardex          KardexMovimiento[]
  cajaOutbox      CajaOutbox[]
  productoBodegas ProductoBodega[]

  @@map("empresas")
}

model Usuario {
  id           String      @id @db.Uuid
  empresaId    String      @map("empresa_id") @db.Uuid
  email        String      @unique @db.VarChar(150)
  nombre       String      @db.VarChar(150)
  rol          RolUsuario  @default(VENDEDOR)
  activo       Boolean     @default(true)
  creadoEn     DateTime    @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  pedidos           Pedido[]           @relation("VendedorPedidos")
  cotizaciones      Cotizacion[]
  movimientosKardex KardexMovimiento[]

  @@index([empresaId], name: "idx_usuarios_empresa")
  @@map("usuarios")
}

model Tercero {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId          String             @map("empresa_id") @db.Uuid
  tipoIdentificacion TipoIdentificacion @map("tipo_identificacion")
  identificacion     String             @db.VarChar(50)
  tipoPersona        TipoPersona        @default(NATURAL) @map("tipo_persona")
  nombre             String             @db.VarChar(255)
  direccion          String?            @db.VarChar(255)
  telefono           String?            @db.VarChar(50)
  email              String?            @db.VarChar(150)
  ciudad             String?            @db.VarChar(100)
  cupoCredito        Decimal            @default(0.00) @map("cupo_credito") @db.Decimal(14, 2)
  creadoEn           DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa            Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  pedidos            Pedido[]
  cotizaciones       Cotizacion[]
  empleado           Empleado?

  @@unique([empresaId, identificacion], name: "uq_tercero_empresa_identificacion")
  @@index([empresaId], name: "idx_terceros_empresa")
  @@map("terceros")
}

model Empleado {
  id                 String    @id @db.Uuid
  empresaId          String    @map("empresa_id") @db.Uuid
  cargo              String    @db.VarChar(100)
  salarioBase        Decimal   @default(0.00) @map("salario_base") @db.Decimal(12, 2)
  fechaIngreso       DateTime  @map("fecha_ingreso") @db.Date
  fechaEgreso        DateTime? @map("fecha_egreso") @db.Date
  urlHojaVida        String?   @map("url_hoja_vida") @db.VarChar(500)
  estado             String    @default("ACTIVO") @db.VarChar(20)
  observaciones      String?   @db.Text
  consentimientoFirmado Boolean @default(false) @map("consentimiento_firmado")
  consentimientoFecha DateTime? @map("consentimiento_fecha") @db.Timestamptz(6)
  creadoEn           DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa            Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tercero            Tercero   @relation(fields: [id], references: [id], onDelete: Restrict)

  @@index([empresaId], name: "idx_empleados_empresa")
  @@map("empleados")
}

model Producto {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String            @map("empresa_id") @db.Uuid
  sku              String            @db.VarChar(50)
  nombre           String            @db.VarChar(255)
  categoria        String            @db.VarChar(100)
  unidadMedida     String            @default("KG") @map("unidad_medida") @db.VarChar(20)
  precioBase       Decimal           @map("precio_base") @db.Decimal(12, 2)
  costoPromedio    Decimal           @default(0.00) @map("costo_promedio") @db.Decimal(12, 2)
  clasificacionAbc ClasificacionAbc  @default(C) @map("clasificacion_abc")
  activo           Boolean           @default(true)
  creadoEn         DateTime          @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  lotes            Lote[]
  kardex           KardexMovimiento[]
  bodegasStock     ProductoBodega[]

  @@unique([empresaId, sku], name: "uq_producto_empresa_sku")
  @@index([empresaId], name: "idx_productos_empresa")
  @@map("productos")
}

model Bodega {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nombre    String   @db.VarChar(100)
  tipo      String   @default("PRINCIPAL") @db.VarChar(50) // PRINCIPAL, SECUNDARIA, AVERIAS
  ubicacion String?  @db.VarChar(255)
  activo    Boolean  @default(true)

  empresa        Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  lotes          Lote[]
  kardex         KardexMovimiento[]
  productosStock ProductoBodega[]

  @@index([empresaId], name: "idx_bodegas_empresa")
  @@map("bodegas")
}

model ProductoBodega {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  productoId    String   @map("producto_id") @db.Uuid
  bodegaId      String   @map("bodega_id") @db.Uuid
  cantidadTotal Decimal  @default(0.00) @map("cantidad_total") @db.Decimal(14, 2)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  producto  Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  bodega    Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Restrict)

  @@unique([productoId, bodegaId], name: "uq_producto_bodega")
  @@index([empresaId], name: "idx_producto_bodegas_empresa")
  @@map("producto_bodegas")
}

model Lote {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId        String       @map("empresa_id") @db.Uuid
  productoId       String       @map("producto_id") @db.Uuid
  bodegaId         String       @map("bodega_id") @db.Uuid
  numeroLote       String       @map("numero_lote") @db.VarChar(100)
  fechaExpiracion  DateTime     @map("fecha_expiracion") @db.Date
  cantidadOriginal Decimal      @map("cantidad_original") @db.Decimal(14, 2)
  cantidadActual   Decimal      @map("cantidad_actual") @db.Decimal(14, 2)
  costoUnitario    Decimal      @map("costo_unitario") @db.Decimal(14, 2)
  estado           EstadoLote   @default(ACTIVO)
  creadoEn         DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn    DateTime     @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  producto  Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)
  bodega    Bodega   @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  kardex    KardexMovimiento[]

  @@index([empresaId], name: "idx_lotes_empresa")
  @@index([productoId, fechaExpiracion], name: "idx_lotes_fefo") // Índice clave para FEFO
  @@map("lotes")
}

model KardexMovimiento {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId           String               @map("empresa_id") @db.Uuid
  bodegaId            String               @map("bodega_id") @db.Uuid
  productoId          String               @map("producto_id") @db.Uuid
  loteId              String?              @map("lote_id") @db.Uuid
  usuarioId           String               @map("usuario_id") @db.Uuid
  tipoMovimiento      TipoMovimientoKardex @map("tipo_movimiento")
  cantidad            Decimal              @db.Decimal(14, 2)
  saldoDespues        Decimal              @map("saldo_despues") @db.Decimal(14, 2)
  costoUnitario       Decimal              @map("costo_unitario") @db.Decimal(14, 2)
  referenciaDocumento String?              @map("referencia_documento") @db.VarChar(100)
  observacion         String?              @db.Text
  creadoEn            DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  bodega    Bodega    @relation(fields: [bodegaId], references: [id], onDelete: Restrict)
  producto  Producto  @relation(fields: [productoId], references: [id], onDelete: Restrict)
  lote      Lote?     @relation(fields: [loteId], references: [id], onDelete: Restrict)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([empresaId], name: "idx_kardex_empresa")
  @@index([productoId, bodegaId], name: "idx_kardex_prod_bodega")
  @@map("kardex_movimientos")
}

model Cotizacion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId      String           @map("empresa_id") @db.Uuid
  clienteId      String           @map("cliente_id") @db.Uuid
  vendedorId     String           @map("vendedor_id") @db.Uuid
  consecutivo    Int              @default(autoincrement())
  estado         EstadoCotizacion @default(BORRADOR)
  subtotal       Decimal          @default(0.00) @db.Decimal(14, 2)
  descuento      Decimal          @default(0.00) @db.Decimal(14, 2)
  impuestos      Decimal          @default(0.00) @db.Decimal(14, 2)
  total          Decimal          @default(0.00) @db.Decimal(14, 2)
  observaciones  String?          @db.Text
  fechaExpiracion DateTime?       @map("fecha_expiracion") @db.Date
  creadoEn       DateTime         @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn  DateTime         @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa        Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente        Tercero          @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor       Usuario          @relation(fields: [vendedorId], references: [id], onDelete: Restrict)

  @@index([empresaId], name: "idx_cotizaciones_empresa")
  @@index([clienteId], name: "idx_cotizaciones_cliente")
  @@map("cotizaciones")
}

model Pedido {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  clienteId   String   @map("cliente_id") @db.Uuid
  vendedorId  String   @map("vendedor_id") @db.Uuid
  consecutivo Int      @default(autoincrement())
  estado      String   @default("PENDIENTE") @db.VarChar(50)
  total       Decimal  @default(0.00) @db.Decimal(14, 2)
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente     Tercero  @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor    Usuario  @relation("VendedorPedidos", fields: [vendedorId], references: [id], onDelete: Restrict)

  @@index([empresaId], name: "idx_pedidos_empresa")
  @@map("pedidos")
}

model Caja {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nombre    String   @db.VarChar(100)
  estado    String   @default("CERRADA") @db.VarChar(20)
  saldoBase Decimal  @default(0.00) @map("saldo_base") @db.Decimal(12, 2)

  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  outbox    CajaOutbox[]

  @@index([empresaId], name: "idx_cajas_empresa")
  @@map("cajas")
}

model CajaOutbox {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresaId     String       @map("empresa_id") @db.Uuid
  cajaId        String       @map("caja_id") @db.Uuid
  idLocal       String       @map("id_local") @db.VarChar(50) // UUID generado en el cliente offline
  tipoOperacion String       @map("tipo_operacion") @db.VarChar(50) // VENTA, GASTO, ARQUEO
  payload       Json         @db.JsonB
  estado        EstadoOutbox @default(PENDIENTE)
  intentos      Int          @default(0)
  errorMsg      String?      @map("error_msg") @db.Text
  creadoEn      DateTime     @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime     @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  caja      Caja    @relation(fields: [cajaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, idLocal], name: "uq_outbox_empresa_local")
  @@index([empresaId, estado], name: "idx_outbox_estado")
  @@map("caja_outbox")
}
