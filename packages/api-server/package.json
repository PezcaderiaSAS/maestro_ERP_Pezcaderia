{
  "name": "@la-pezcaderia/api-server",
  "version": "1.0.0",
  "private": true,
  "description": "Express API server to expose Prisma Server Actions for Vite Frontend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "@la-pezcaderia/database-shared": "workspace:*",
    "@la-pezcaderia/validation-schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "typescript": "^5.2.2",
    "ts-node-dev": "^2.0.0"
  }
}
