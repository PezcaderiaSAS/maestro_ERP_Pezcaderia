{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "mcp-deepseek-r1": {
      "command": "cmd",
      "args": ["/c", "echo", "DeepSeek-R1 MCP is managed by Antigravity Host"],
      "autoStart": true
    },
    "mcp-qwen-coder": {
      "command": "cmd",
      "args": ["/c", "echo", "Qwen-Coder MCP is managed by Antigravity Host"],
      "autoStart": true
    },
    "mcp-kimi-code": {
      "command": "cmd",
      "args": ["/c", "echo", "Kimi-Code MCP is managed by Antigravity Host"],
      "autoStart": true
    },
    "ricoui-design-mcp": {
      "command": "node",
      "args": [
        "tools/ricoui-mcp/server.cjs",
        "--mcp"
      ],
      "env": {
        "NODE_ENV": "development",
        "RICOUI_DEFAULT_BRAND": "pezcaderia-glass"
      },
      "autoStart": true
    }
  }
}