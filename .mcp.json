{
  "mcpServers": {
    "claude-flow": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "autoStart": false
    },
    "mcp-deepseek-r1": {
      "command": "cmd",
      "args": ["/c", "echo", "DeepSeek-R1 MCP is managed by Antigravity Host"],
      "autoStart": true
    },
    "mcp-qwen-coder": {
      "command": "cmd",
      "args": ["/c", "echo", "Qwen-Coder MCP is managed by Antigravity Host"],
      "autoStart": true
    },
    "mcp-kimi-code": {
      "command": "cmd",
      "args": ["/c", "echo", "Kimi-Code MCP is managed by Antigravity Host"],
      "autoStart": true
    },
    "ricoui-design-mcp": {
      "command": "node",
      "args": [
        "tools/ricoui-mcp/server.cjs",
        "--mcp"
      ],
      "env": {
        "NODE_ENV": "development",
        "RICOUI_DEFAULT_BRAND": "pezcaderia-glass"
      },
      "autoStart": true
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@mcp/chrome-devtools"
      ],
      "autoStart": true
    },
    "context7": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@context7/mcp"
      ],
      "autoStart": true
    },
    "figma": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@figma/mcp-server"
      ],
      "env": {
        "FIGMA_ACCESS_TOKEN": "<TU_FIGMA_PERSONAL_ACCESS_TOKEN>"
      },
      "autoStart": false
    },
    "github": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<TU_GITHUB_TOKEN>"
      },
      "autoStart": false
    },
    "stitch": {
      "serverUrl": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
    "hindsight": {
      "serverUrl": "https://api.hindsight.vectorize.io/mcp/pezcaderia-erp/",
      "headers": {
        "Authorization": "Bearer ${HINDSIGHT_API_KEY}"
      }
    }
  }
}