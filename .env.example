# ---------------------------------------------------------
# 6. DAEMON AUTÓNOMO 24/7 & EVOLUTION API (WhatsApp)
# ---------------------------------------------------------
# Completa estos valores en tu `.env` o `.env.local` antes de iniciar `npm run daemon:start`
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=tu_api_key_de_evolution_aqui
EVOLUTION_INSTANCE=maestro_pescaderia
# Secreto opcional del webhook (si se omite, valida contra EVOLUTION_API_KEY)
EVOLUTION_WEBHOOK_SECRET=tu_secreto_webhook_evolution
# Versión de payload saliente sendText: v2 (default) o v1
EVOLUTION_API_VERSION=v2
# Números autorizados en formato internacional sin '+' ni espacios (separados por coma)
WHATSAPP_ADMIN_PHONES=573001234567
# Habilita comandos desde el propio chat (un solo número WhatsApp). Mantener false si usas dos números.
EVOLUTION_ALLOW_SELF_CHAT=false
# Opcional: IDs LID autorizados si WhatsApp entrega @lid sin remoteJidAlt en self-chat
# WHATSAPP_ADMIN_LIDS=
WHATSAPP_WEBHOOK_PORT=3005
# Modo de ejecución del puente SDD: true (simulación segura por defecto) | false (ejecución real)
DAEMON_SDD_DRY_RUN=true
# Timeout de verificación estática TypeScript (en milisegundos)
DAEMON_TSC_TIMEOUT_MS=90000
# Compatibilidad opcional con pruebas/simulador Meta Graph API
WHATSAPP_WEBHOOK_VERIFY_TOKEN=la_pezcaderia_daemon_webhook_token_2026
WHATSAPP_APP_SECRET=test_meta_app_secret_12345
