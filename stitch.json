{
  "$schema": "https://stitch.google.com/schemas/v1/stitch.json",
  "project": {
    "name": "Pezcaderia ERP / FerreOn NextJS",
    "version": "2.0.0",
    "theme_mode": "dark-glassmorphism",
    "framework": "React 18 / Next.js 14+ (App Router)",
    "styling": "Tailwind CSS v3/v4",
    "icon_library": "lucide-react"
  },
  "design_system": {
    "source_specification": "DESIGN.md",
    "mcp_server": "ricoui-design-mcp",
    "default_brand": "pezcaderia-glass",
    "tokens": {
      "colors": {
        "canvas_background": "hsl(222, 47%, 8%)",
        "surface_card": "hsl(222, 47%, 11%)",
        "surface_card_alpha": "0.75",
        "border_subtle": "rgba(255, 255, 255, 0.12)",
        "primary_indigo": "hsl(244, 75%, 59%)",
        "accent_cyan": "hsl(189, 94%, 43%)",
        "success_emerald": "hsl(160, 84%, 39%)",
        "warning_amber": "hsl(38, 92%, 50%)",
        "danger_rose": "hsl(0, 84%, 60%)",
        "text_primary": "hsl(210, 40%, 98%)",
        "text_secondary": "hsl(218, 11%, 65%)",
        "text_muted": "hsl(220, 9%, 46%)"
      },
      "typography": {
        "sans": "Inter, system-ui, sans-serif",
        "display": "Outfit, Inter, sans-serif",
        "mono": "JetBrains Mono, Fira Code, monospace"
      },
      "glassmorphism": {
        "backdrop_blur": "backdrop-blur-xl",
        "glass_overlay": "linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.02) 100%)",
        "border_glass": "border border-white/10",
        "shadow_ambient": "shadow-xl",
        "shadow_glow": "shadow-[0_0_20px_rgba(6,182,212,0.15)]"
      },
      "themes": {
        "pezcaderia-glass": {
          "name": "Pezcaderia Dark Glass (Canónico)",
          "archetype": "Dark Glassmorphism",
          "canvas_background": "#0a0f1d",
          "surface_card": "rgba(17, 24, 39, 0.75)",
          "primary": "#4f46e5",
          "accent": "#06b6d4",
          "border": "rgba(255, 255, 255, 0.12)",
          "badge": "PEZCADERIA S.A.S"
        },
        "hyper-cobalt": {
          "name": "Hyper Cobalt & Skin Sand",
          "archetype": "Dark Glassmorphism Vibrant",
          "canvas_background": "#050b1a",
          "surface_card": "rgba(8, 16, 38, 0.78)",
          "primary": "#0038FF",
          "accent": "#FFD8B8",
          "border": "rgba(255, 216, 184, 0.18)",
          "badge": "COBALT & SAND"
        },
        "carbon-teal": {
          "name": "Carbon Teal & Mint Foam",
          "archetype": "Dark Industrial Maritime",
          "canvas_background": "#021214",
          "surface_card": "rgba(4, 47, 50, 0.75)",
          "primary": "#042F32",
          "accent": "#D6FFCB",
          "border": "rgba(214, 255, 203, 0.18)",
          "badge": "TEAL & MINT"
        },
        "chrome-violet": {
          "name": "Chrome Violet & Glass Blue",
          "archetype": "Dark Cyber Executive",
          "canvas_background": "#0a0618",
          "surface_card": "rgba(28, 16, 64, 0.75)",
          "primary": "#5F2CFF",
          "accent": "#DFF6FF",
          "border": "rgba(223, 246, 255, 0.18)",
          "badge": "VIOLET & BLUE"
        }
      }
    }
  },
  "prompt_templates": {
    "dashboard_kpi": {
      "title": "Dashboard Ejecutivo & KPIs Operativos",
      "instruction": "Genera una vista de métricas de alto rendimiento con tarjetas KPI translúcidas (backdrop-blur-xl, border-white/10), sparklines con gradiente cian/índigo, comparativas porcentuales de periodo anterior e indicador de estado en tiempo real.",
      "components_required": ["KpiCard", "SparklineChart", "QuickFilterBar", "RecentActivityFeed"]
    },
    "pos_cash": {
      "title": "Punto de Venta (POS) & Arqueo de Caja",
      "instruction": "Diseña una interfaz de terminal POS con catálogo de productos en cuadrícula táctil, panel de carrito lateral con cálculo automático de IVA y descuentos, y modal de arqueo de caja ciega con teclado numérico ergonómico.",
      "components_required": ["ProductGridItem", "CartSummaryPanel", "PaymentMethodSelector", "BlindCashReconciliationModal"]
    },
    "wms_inventory": {
      "title": "Almacén WMS & Control de Cuartos Fríos (FEFO)",
      "instruction": "Genera una vista de gestión de inventario perecedero con badges de caducidad FEFO/FIFO por colores de alerta (Verde >30d, Amarillo 10-30d, Rojo <10d), monitores de temperatura de cuarto frío y tabla de despiece.",
      "components_required": ["ColdRoomTempCard", "FefoBatchTable", "MeatYieldCalculator", "StockTransferModal"]
    },
    "b2b_pricing": {
      "title": "Cotizaciones B2B & Simulador de Márgenes",
      "instruction": "Genera un modal y wizard de cotización B2B con cálculo en tiempo real de margen bruto, escala de precios por volumen, diferenciación de líneas de producto por empaque/gramaje y botón de exportación PDF.",
      "components_required": ["PricingModal", "QuoteWizardStep", "MarginHealthIndicator", "PdfExportButton"]
    }
  },
  "quality_gates": {
    "accessibility_standard": "WCAG 2.1 AA",
    "minimum_contrast_ratio": 4.5,
    "responsive_breakpoints": {
      "mobile": "375px",
      "tablet": "768px",
      "desktop": "1280px",
      "ultrawide": "1920px"
    },
    "anti_patterns": [
      "No usar colores planos o grises genéricos sin alpha/blur.",
      "No usar placeholders genéricos (Lorem Ipsum); usar datos coherentes del dominio pez/cárnico/ferretero.",
      "No mutar props ni variables de estado directamente en componentes React."
    ]
  }
}
